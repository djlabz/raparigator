# ==============================================================================
# Variáveis de ambiente de produção para o Docker Compose (compose.prod.yaml)
# Copie para .env.prod e preencha os valores antes de subir a stack:
#   cp .env.prod.example .env.prod
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d
# ==============================================================================

# Banco de dados (Postgres)
POSTGRES_USER=sigillus
POSTGRES_PASSWORD=gere-uma-senha-forte-para-o-postgres
POSTGRES_DB=sigillus
POSTGRES_PORT=5432

# Armazenamento de mídia (MinIO / S3)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY_ID=sigillus
S3_SECRET_ACCESS_KEY=gere-um-secret-forte-para-o-s3
S3_BUCKET=sigillus-media
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/sigillus-media
S3_FORCE_PATH_STYLE=true

# Portas externas dos serviços
API_PORT=4000
WEB_PORT=3000

# Domínios e URLs (ajuste para o seu domínio real em produção)
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
NEXT_PUBLIC_API_URL=http://localhost:4000

# Autenticação (Better Auth - mínimo 32 caracteres aleatórios)
AUTH_SECRET=gere-uma-chave-secreta-com-pelo-menos-32-caracteres-aleatorios

# Faturamento (fake durante o lançamento com anúncios e premium gratuitos)
BILLING_PROVIDER=fake
BILLING_FAKE_ACKNOWLEDGED=true
BILLING_WEBHOOK_SECRET=

# Provedor de e-mail (Resend)
MAIL_PROVIDER=resend
RESEND_API_KEY=re_sua_chave_do_resend_aqui
MAIL_FROM=Sigillus <nao-responda@sigillus.dev>

# Configurações de negócio
VERIFICATION_REQUIRED=false
VERIFICATION_DEV_CODES=false
PREMIUM_CHECKOUT_ENABLED=false
OPENAPI_DOCS_ENABLED=false

# Monitoramento de erros (opcional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
