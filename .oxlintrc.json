{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "react", "jsx-a11y", "nextjs", "import"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.2.3"
    }
  },
  "rules": {
    "no-unassigned-vars": "error",
    "no-useless-assignment": "error",
    "preserve-caught-error": "error",

    // Paridade com o eslint-config-next: eram error la e nao estao na
    // categoria `correctness` do oxlint, entao precisam ser explicitas.
    "react-hooks/rules-of-hooks": "error",
    "react/no-unescaped-entities": "error",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-require-imports": "error",

    // Next.js usa o JSX runtime automatico
    "react/react-in-jsx-scope": "off",

    // Unica regra a11y desligada. Ela nao distingue "usou role por preguica"
    // de "usou role porque a tag nativa nao serve", e neste projeto e sempre
    // o segundo caso: combobox custom (select.tsx), 5 modais animados em
    // portal, radiogroup de rating, editor contentEditable e cards clicaveis
    // com botao aninhado. Satisfazer a regra exigiria reescrever esses
    // componentes e perder os padroes ARIA corretos que eles ja implementam.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    ".tmp-venv/**",
    ".agents/**",
    ".claude/**",
    ".superpowers/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
